  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">WizGuide - Circuit Guide (video-guided build)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.RenderMesh boxMesh {"hint":"Unit cube mesh (1 cm)"}'
    - '// @input Asset.RenderMesh sphereMesh {"hint":"Unit sphere mesh (1 cm)"}'
    - '// @input Asset.RenderMesh cylinderMesh {"hint":"Unit cylinder mesh (1 cm)"}'
    - '// @input Asset.Material litMaterial {"hint":"Lit glTF material"}'
    - '// @input Asset.Material unlitMaterial {"hint":"Unlit material (glow, panels)"}'
    - "// @input Asset.ObjectPrefab userModel {\"hint\":\"Optional: the user's imported FBX prefab (Assets/UserModels). Used when Model source is FBX.\"}"
    - '// @input Asset.ObjectPrefab[] userModels {"hint":"LOAD MODEL list: import your FBX into Assets/UserModels, make it a prefab (right-click > Create Prefab), then drag it into this list. The MODEL picker on the BUILD page steps through RC car, the built-in sample models and this list."}'
    - '// @input Asset.JsonAsset[] circuitFiles {"hint":"Circuits to build (JSON assets): a KiCad schematic wrapped by tools/wrap-kicad.mjs, a step list written by tools/video-to-pack.mjs, or the parts + connections a photo was read into. Each one shows up in the search list and on MY MODEL."}'
    - '// @input Asset.Texture circuitPhoto {"hint":"A photo or picture of a circuit. The CONVERT PHOTO button on MY MODEL reads it with Gemini (needs the key and Live AI on) and turns it into a guided build."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input string startMode = "menu" {"hint":"What opens on reset: the original 3D Wiz main menu (Lab / Circuit / Visualize), or the Circuit Guide directly", "widget":"combobox", "values":[{"label":"Main menu (3D Wiz)", "value":"menu"}, {"label":"Circuit Guide directly", "value":"guide"}]}'
    - '// @input string modelSource = "rc" {"hint":"Model on the table: the RC car sample parts or the imported FBX", "widget":"combobox", "values":[{"label":"RC car (printed parts)", "value":"rc"}, {"label":"User FBX prefab", "value":"fbx"}]}'
    - '// @input float benchScale = 0.9 {"hint":"Size of the work table content (1 = real size; larger is easier to grab)", "widget":"slider", "min":0.7, "max":2.2, "step":0.1}'
    - '// @input float tableTiltDeg = 40 {"hint":"How far the table top is tilted toward you (degrees); 0 = flat", "widget":"slider", "min":0, "max":60, "step":1}'
    - '// @input float panelWidthCm = 18 {"hint":"Width of the left step panel in cm", "widget":"slider", "min":16, "max":30, "step":1}'
    - '// @input float orbDistanceCm = 50 {"hint":"Distance of the voice orb in front of you in cm (front-right)", "widget":"slider", "min":35, "max":70, "step":1}'
    - '// @input float successHoldS = 1.1 {"hint":"Seconds the green success glow shows before the next step starts", "widget":"slider", "min":0.4, "max":3, "step":0.1}'
    - '// @input string geminiKey {"hint":"Gemini API key (optional). Better: put it in .env and run tools/apply-env.ps1 (see README). If you paste it here, CLEAR it before saving or committing. Never logged or echoed by the Lens. Empty here AND in .env = offline."}'
    - '// @input bool liveAi {"hint":"Live AI (Gemini). OFF = the demo is fully offline and instant: no network call is ever made. ON = Gemini only warms a cache in the background and powers ASK MORE; it never blocks or changes the demo."}'
    - '// @input string geminiModel = "gemini-flash-latest" {"hint":"Gemini model used for the intent and the step list (a small fast one)"}'
    - '// @input string groqModel = "llama-3.3-70b-versatile" {"hint":"Groq model, used when the key starts with gsk_ (Groq keys use the OpenAI-compatible endpoint)"}'
    - '// @input bool debugLog {"hint":"Log steps and results (debug)"}'
    - '// @ui {"widget":"group_end"}'
